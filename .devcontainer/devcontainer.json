{
  "name": "MyMovie Server",
  "workspaceFolder": "/workspace",
  // Before the container is created, ensure we have the personal override file in place.
  "initializeCommand": "cp --update=none .devcontainer/docker-compose.personal.yml.template .devcontainer/docker-compose.personal.yml",
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.personal.yml"],
  "service": "devcontainer",
  "remoteUser": "vscode",
  "portsAttributes": {
    "443": {
      "label": "HTTPS",
      "protocol": "https",
      "onAutoForward": "openBrowser"
    },
    "5678": {
      "label": "debugpy",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "Django Dev Server",
      "onAutoForward": "notify"
    },
    "8025": {
      "label": "Mailpit",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": {
    // Fix permissions on the volume mount; see https://github.com/microsoft/vscode-remote-release/issues/9931
    // Install package requirements
    "setupEnvironment": "sudo chown -R $(whoami): ${containerWorkspaceFolder}/.venv /home/vscode/.cache && just install"
  },
  // postStartCommand runs every time the container starts — re-syncs deps in case
  // pyproject.toml changed (e.g. after a git pull) without rebuilding the container
  "postStartCommand": "~/.local/bin/pdm sync",
  "containerEnv": {
    "DISPLAY": "dummy"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    "PRE_COMMIT_HOME": "/home/vscode/.cache/pre-commit",
    "PRE_COMMIT_USE_UV": "1",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv"
  },
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly",
    "source=precommit-cache,target=/home/vscode/.cache/pre-commit,type=volume",
    "source=my-project-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  "features": {
    "ghcr.io/va-h/devcontainers-features/difftastic:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/just:1": {},
    "ghcr.io/devcontainers-extra/features/curl-apt-get:1": {},
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {},
    "ghcr.io/nlstn/devcontainer-features/psql:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "donjayamanne.githistory",
        "editorconfig.editorconfig",
        "iulian-radu-at.save-restore-editors",
        "mk12.better-git-line-blame",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "redhat.vscode-yaml",
        "skellock.just",
        "tamasfe.even-better-toml",
        "typefox.open-collaboration-tools",
        "yzhang.markdown-all-in-one",
        "detachhead.basedpyright",
        "monosans.djlint"
      ],
      "settings": {
        "python.testing.unittestEnabled": false,
        "python.testing.pytestEnabled": true,
        "files.watcherExclude": {
          ".venv/**": true,
          "**/__pycache__/**": true,
          "**/.mypy_cache/**": true,
          "**/.pytest_cache/**": true
        },
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
